# Build trees. `build/` is the default; the other two are the deliberate
# second and third configurations -- both halves of the desktop #ifdef get
# compiled before a ship, and each needs its own tree.
/build/
/build-ecal/
/build-noecal/
build*/

# The reference docs (RULES / CANON / ARCHITECTURE / ARC / HANDOFF) are NOT in
# this repository, by Scott's standing instruction: our docs never go into a
# GitHub project. They travel as docs.zip between sessions and live only on his
# disk. s013 put them under docs/ inside the repo; s014 took them back out.
/docs/

/backups/
compile_commands.json
*.o
*.a
.cache/

