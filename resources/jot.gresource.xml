<?xml version="1.0" encoding="UTF-8"?>
<!-- jot resource bundle. The resource-pipeline paradigm: an app asset carried
     the symbolic way (a currentColor SVG under the freedesktop icon-theme shape)
     so set_icon_name("jot-logo-symbolic") resolves it out of the compiled-in
     binary and GTK recolours it to the theme foreground -- no icon installed on
     the user's disk.

     Gotcha the shape encodes: GTK's icon lookup is RIGID about the trailing
     .../scalable/apps/ path, so the prefix ends there and App::on_activate
     passes only /io/github/scott8420/Jot/icons to add_resource_path (GTK appends
     scalable/apps/ itself). The prefix mirrors the app-id; both move together in
     a one-pass rename. See docs/resources-and-dialog-lifetime.md. -->
<gresources>
  <gresource prefix="/io/github/scott8420/Jot/icons/scalable/apps">
    <file preprocess="xml-stripblanks" alias="jot-logo-symbolic.svg">icons/scalable/apps/jot-logo-symbolic.svg</file>
    <!-- s034b: the SAME file under a name nothing installs. install-desktop.sh puts
         jot-logo-symbolic in ~/.local/share/icons, and GTK searches theme dirs
         BEFORE resource paths -- so a stale installed copy shadowed the bundle.
         In-app widgets use this name; the desktop entry and notifications keep
         jot-logo-symbolic (GNOME Shell can only see the installed one). -->
    <file preprocess="xml-stripblanks" alias="jot-app-logo-symbolic.svg">icons/scalable/apps/jot-logo-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-pane-left-symbolic.svg">icons/scalable/apps/jot-pane-left-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-pane-right-symbolic.svg">icons/scalable/apps/jot-pane-right-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-order-single-symbolic.svg">icons/scalable/apps/jot-order-single-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-order-sequential-symbolic.svg">icons/scalable/apps/jot-order-sequential-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-order-parallel-symbolic.svg">icons/scalable/apps/jot-order-parallel-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-order-none-symbolic.svg">icons/scalable/apps/jot-order-none-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-state-hold-symbolic.svg">icons/scalable/apps/jot-state-hold-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-state-dropped-symbolic.svg">icons/scalable/apps/jot-state-dropped-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-state-done-symbolic.svg">icons/scalable/apps/jot-state-done-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-state-active-symbolic.svg">icons/scalable/apps/jot-state-active-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-view-source-symbolic.svg">icons/scalable/apps/jot-view-source-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-view-reading-symbolic.svg">icons/scalable/apps/jot-view-reading-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-view-live-symbolic.svg">icons/scalable/apps/jot-view-live-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-filter-symbolic.svg">icons/scalable/apps/jot-filter-symbolic.svg</file>
    <!-- s048: the tabs and Today's view buttons. Scott's Curvz drawings replace these file for file, same names. -->
    <file preprocess="xml-stripblanks" alias="jot-tab-notes-symbolic.svg">icons/scalable/apps/jot-tab-notes-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-tab-inbox-symbolic.svg">icons/scalable/apps/jot-tab-inbox-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-tab-today-symbolic.svg">icons/scalable/apps/jot-tab-today-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-tab-tags-symbolic.svg">icons/scalable/apps/jot-tab-tags-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-tab-projects-symbolic.svg">icons/scalable/apps/jot-tab-projects-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-view-today-symbolic.svg">icons/scalable/apps/jot-view-today-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-view-available-symbolic.svg">icons/scalable/apps/jot-view-available-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-view-flagged-symbolic.svg">icons/scalable/apps/jot-view-flagged-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-view-logbook-symbolic.svg">icons/scalable/apps/jot-view-logbook-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="jot-view-forecast-symbolic.svg">icons/scalable/apps/jot-view-forecast-symbolic.svg</file>
  </gresource>
</gresources>
