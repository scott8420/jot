[Desktop Entry]
Type=Application
Name=jot
GenericName=Notes and Todos
Comment=A scribble pad that files itself
Exec=@JOT_EXEC@
Icon=jot-logo-symbolic
Terminal=false
Categories=Utility;TextEditor;ProjectManagement;
Keywords=notes;todo;markdown;gtd;
